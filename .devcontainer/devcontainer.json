{
  "name": "py2048",
  "image": "mcr.microsoft.com/devcontainers/base:noble",

  // No python feature: uv owns the interpreter. A second Python on PATH
  // shadows uv's silently, and the failure looks like anything but that.
  "features": {
    "ghcr.io/devcontainers/features/powershell:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" }
  },

  // Claude Code keeps its config, history and memory in ~/.claude, which lives in
  // the container's home and would be wiped by every rebuild. A named volume
  // outlives the container.
  "mounts": [
    "source=py2048-claude,target=/home/vscode/.claude,type=volume"
  ],

  "postCreateCommand": "pwsh ./.devcontainer/postCreateCommand.ps1",

  "containerEnv": {
    // Inside the workspace so rebuilds do not re-download, and on the same
    // filesystem as .venv so uv can hardlink rather than copy.
    "UV_CACHE_DIR": "/workspaces/2048/.uv-cache"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-vscode.powershell",
        "anthropic.claude-code"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "pwsh",
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "files.exclude": { ".uv-cache": true }
      }
    }
  },

  "remoteUser": "vscode"
}
